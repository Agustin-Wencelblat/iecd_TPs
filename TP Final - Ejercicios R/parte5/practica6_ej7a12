# Ejercicio 10
# Regresion lineal simple con datos simulados: y = -1 + 0.5 x + epsilon


ejercicio10 <- function(sigma2, n = 100, semilla = 10) {
  set.seed(semilla)
  cat("\n sigma^2 =", sigma2)

  # a) b) c)
  x <- rnorm(n) # N(0, 1)
  epsilon <- rnorm(n, mean = 0, sd = sqrt(sigma2))
  y <- -1 + 0.5 * x + epsilon
  cat("longitud de y:", length(y), "  (beta0 = -1, beta1 = 0.5)\n")

  # d) scatterplot
  plot(x, y, pch = 19, col = "grey40", main = bquote(sigma^2 == .(sigma2)))

  # e) ajuste lineal
  ajuste <- lm(y ~ x)
  print(summary(ajuste)$coefficients)
  cat("sigma^2 estimado (S^2):", summary(ajuste)$sigma^2, "  verdadero:", sigma2, "\n")
  print(confint(ajuste))

  # f) recta estimada y recta verdadera
  abline(ajuste, col = "red", lwd = 2)
  abline(a = -1, b = 0.5, col = "blue", lwd = 2, lty = 2)

  # g) modelo cuadratico
  ajuste2 <- lm(y ~ x + I(x^2))
  print(summary(ajuste2)$coefficients)
  grilla <- seq(min(x), max(x), length.out = 200)
  lines(grilla, predict(ajuste2, data.frame(x = grilla)), col = "darkgreen", lwd = 2)
  legend("topleft", bg = "white", cex = 0.85, lwd = 2, lty = c(1, 2, 1),
         col = c("red", "blue", "darkgreen"),
         legend = c("recta de minimos cuadrados", "recta verdadera", "ajuste cuadratico"))
  cat("R^2 lineal:", summary(ajuste)$r.squared,
      "  R^2 cuadrático:", summary(ajuste2)$r.squared, "\n")
  print(anova(ajuste, ajuste2))     # test F de que el termino cuadrático vale 0
  invisible(list(lineal = ajuste, cuadratico = ajuste2))
}

# a) a g) con sigma^2 = 0.025; h) con 10 y 100 veces más varianza
par(mfrow = c(1, 3))
for (s2 in c(0.025, 0.25, 2.5)) ejercicio10(s2)
par(mfrow = c(1, 1))



# IECD - Práctica 6 (Regresión lineal) - Ejercicio 11
# y = 2 + 2 x1 + 0.3 x2 + epsilon,  x1, x2 ~ U(0, 1)


ejercicio11 <- function(sigma, n = 100, semilla = 11) {
  set.seed(semilla)
  cat("\n sigma =", sigma)

  # a) datos (verdaderos coeficientes: beta0 = 2, beta1 = 2, beta2 = 0.3)
  x1 <- runif(n)
  x2 <- runif(n)
  y  <- 2 + 2 * x1 + 0.3 * x2 + rnorm(n, 0, sigma)

  # b) scatterplots de a pares
  pairs(data.frame(y, x1, x2), pch = 19, col = "grey40",
        main = paste("sigma =", sigma))

  # c) ajuste, significatividad, R^2 y test F
  ajuste <- lm(y ~ x1 + x2)
  s <- summary(ajuste)
  print(s$coefficients)
  f <- s$fstatistic
  cat("R^2 =", round(s$r.squared, 4),
      "  F =", round(f[1], 2), "  p-valor F =",
      signif(pf(f[1], f[2], f[3], lower.tail = FALSE), 3), "\n")
  print(confint(ajuste))
  invisible(ajuste)
}

ejercicio11(sigma = 1)       # a), b), c)
ejercicio11(sigma = 0.5)     # d)
ejercicio11(sigma = 0.25)    # d)



# Ejercicio 12
# correlacion entre los estimadores de minimos cuadrados
# y_i = 1 + 2 x_i1 + 4 x_i2 + eps_i,  (x1, x2) ~ N2(mu, Sigma),  eps ~ N(0, 1)


library(MASS)                      # mvrnorm
beta <- c(1, 2, 4)
n    <- 50
Nrep <- 1000

# Correlacion entre los coeficientes a partir de una matriz de diseno:
# Cov(beta_hat) = sigma^2 (X'X)^{-1}  =>  corr_ij = c_ij / sqrt(c_ii c_jj)
cor_desde_C <- function(C) {
  r <- unname(cov2cor(C))
  c(b0_b1 = r[1, 2], b0_b2 = r[1, 3], b1_b2 = r[2, 3])
}

escenario <- function(mu, Sigma, titulo, semilla) {
  set.seed(semilla)
  cat("\n================", titulo, "================\n")

  # a) una muestra de (x1, x2)
  X12 <- mvrnorm(n, mu = mu, Sigma = Sigma)
  cat("correlación muestral entre x1 y x2:", round(cor(X12[, 1], X12[, 2]), 3), "\n")

  # b) y c) respuestas y ajuste
  y <- beta[1] + X12 %*% beta[2:3] + rnorm(n)
  coefs <- coef(lm(y ~ X12[, 1] + X12[, 2]))
  print(rbind(verdadero = beta, estimado = round(unname(coefs), 4)))

  # d) correlaciones estimadas a partir de la matriz de diseno de esta muestra
  X <- cbind(1, X12)
  cat("d) correlaciones según (X'X)^{-1}:\n")
  print(round(cor_desde_C(solve(t(X) %*% X)), 3))

  # e) Nrep repeticiones de a), b), c)
  B <- t(replicate(Nrep, {
    X12 <- mvrnorm(n, mu = mu, Sigma = Sigma)
    y   <- beta[1] + X12 %*% beta[2:3] + rnorm(n)
    coef(lm(y ~ X12[, 1] + X12[, 2]))
  }))
  colnames(B) <- c("b0_hat", "b1_hat", "b2_hat")

  # f) scatterplots y correlaciones muestrales
  pairs(B, pch = 20, col = rgb(0, 0, 0, 0.3), main = titulo)
  R <- cor(B)
  cat("f) correlaciones muestrales entre los 1000 vectores de coeficientes:\n")
  print(round(c(b0_b1 = R[1, 2], b0_b2 = R[1, 3], b1_b2 = R[2, 3]), 3))

  # Referencia: aproximación con E(X'X)/n en lugar de X'X
  M <- rbind(c(1, mu), cbind(mu, Sigma + mu %o% mu))
  cat("aproximación teórica con E(X'X):\n")
  print(round(cor_desde_C(solve(M)), 3))
  invisible(B)
}

Sigma_a <- matrix(c(1, 0.5, 0.5, 1), 2)
escenario(c(1, 2), Sigma_a,  "a)-f): mu = (1, 2), corr(x1, x2) = 0.5", semilla = 12)
escenario(c(5, 2), diag(2),  "g): mu = (5, 2), Sigma = I",              semilla = 13)
escenario(c(0, 2), diag(2),  "h): mu = (0, 2), Sigma = I",              semilla = 14)
