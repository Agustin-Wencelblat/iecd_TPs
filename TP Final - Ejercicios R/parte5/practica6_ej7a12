# IECD - PrActica 6 (Regresión lineal) - Ejercicio 7
# SelecciOn de modelos con un conjunto de validaciOn (credit.txt)


credit <- read.table("credit.txt", header = TRUE, sep = ",")
n <- nrow(credit)

# ParticiOn aleatoria: ~2/3 entrenamiento, el resto testeo
set.seed(7)
idx_train <- sample(1:n, size = round(2 * n / 3))
train <- credit[idx_train, ]
test  <- credit[-idx_train, ]

# Los 8 subconjuntos de {Income, Cards, Age} (el vacIo = sOlo intercept)
vars <- c("Income", "Cards", "Age")
subconjuntos <- unlist(lapply(0:3, function(k) combn(vars, k, simplify = FALSE)),
                       recursive = FALSE)

W_modelo <- function(sub, train, test) {
  formula <- if (length(sub) == 0) Balance ~ 1
             else as.formula(paste("Balance ~", paste(sub, collapse = " + ")))
  ajuste <- lm(formula, data = train)                 # coeficientes con Entrenamiento
  pred   <- predict(ajuste, newdata = test)           # predicción de Testeo
  sum((test$Balance - pred)^2)                        # W
}

nombres <- sapply(subconjuntos, function(s) if (length(s) == 0) "(sólo intercept)"
                                            else paste(s, collapse = " + "))
W <- sapply(subconjuntos, W_modelo, train = train, test = test)
resultado <- data.frame(modelo = nombres, W = W)
resultado[order(resultado$W), ]

# Ejercicio 8
# Validación cruzada "dejando uno afuera" para 4 modelos (glakes.csv)

glakes <- read.csv("glakes.csv")
Peso   <- glakes$Tonnage
Tiempo <- glakes$Time
n <- length(Tiempo)
datos <- data.frame(Tiempo, Peso, P25 = Peso^0.25, P50 = Peso^0.5)

modelos <- list(
  a = list(f = Tiempo ~ 0 + Peso,            back = identity),  # sin intercept
  b = list(f = Tiempo ~ Peso,                back = identity),
  c = list(f = log(Tiempo) ~ P25,            back = exp),
  d = list(f = log(Tiempo) ~ P25 + P50,      back = exp)
)

W_loo <- function(m) {
  r <- numeric(n)
  for (i in 1:n) {
    ajuste <- lm(m$f, data = datos[-i, ])                 # todas salvo la i-ésima
    pred   <- m$back(predict(ajuste, newdata = datos[i, ]))
    r[i]   <- datos$Tiempo[i] - pred                      # residuo en la escala de Tiempo
  }
  sum(r^2)
}

W <- sapply(modelos, W_loo)
round(sort(W), 1)

# Para comparar: suma de residuos al cuadrado sin dejar afuera
W_train <- sapply(modelos, function(m) sum((datos$Tiempo - m$back(fitted(lm(m$f, data = datos))))^2))
round(rbind(LOOCV = W, entrenamiento = W_train), 1)

plot(Peso, Tiempo, pch = 19, main = "Grand Lakes: tiempo de descarga vs. peso")
grilla <- data.frame(Peso = seq(min(Peso), max(Peso), length.out = 300))
grilla$P25 <- grilla$Peso^0.25; grilla$P50 <- grilla$Peso^0.5
cols <- c(a = "grey50", b = "blue", c = "red", d = "darkgreen")
for (k in names(modelos)) {
  lines(grilla$Peso, modelos[[k]]$back(predict(lm(modelos[[k]]$f, data = datos), grilla)),
        col = cols[k], lwd = 2)
}
legend("topleft", bty = "n", lwd = 2, col = cols, legend = paste("modelo", names(modelos)))



